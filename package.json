{
  "name": "portfoliocms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "build": "node ./node_modules/vite/bin/vite.js --config client/vite.config.ts",
    "start": "node ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "preview": "node ./node_modules/vite/bin/vite.js preview --config client/vite.config.ts",
    "db:generate": "node ./node_modules/prisma/build/index.js generate --schema server/prisma/schema.prisma",
    "db:push": "node ./node_modules/prisma/build/index.js db push --schema server/prisma/schema.prisma",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^7.2.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
